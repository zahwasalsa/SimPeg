NODE_ENV=development
PORT=3000

SUPABASE_URL=
# Publishable/anon key (safe for client exposure). Only usable by GoTrue (auth), not REST/database.
SUPABASE_ANON_KEY=
# Secret key (Dashboard > Project Settings > API Keys > Secret keys). Required for backend DB access.
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

CORS_ORIGIN=http://localhost:3000
